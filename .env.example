# ------------------------------------------------------------------
# Gym Management System — Firebase configuration
# Copy this file to `.env` and fill in your Firebase project values.
# NEVER commit the real `.env` file.
# ------------------------------------------------------------------



VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# Set to "true" ONLY in development to allow seeding sample data.
# Default is FALSE: a production build that inherits this file must never be
# able to populate a real gym with sample members, payments and receipts.
VITE_ENABLE_SEEDING=false

# Set to "true" once the Cloud Functions in ./functions are deployed for this
# project. Every callable is declared in asia-south1. While this is false (the
# default) the Settings integrity card makes NO call at all: an undeployed
# endpoint answered 404, which the browser reported as a CORS error on every
# Settings load.
VITE_ENABLE_CALLABLES=false

# Set to "true" ONLY in development to point the app at the local Firebase
# emulators (Auth 9099, Firestore 8080, Storage 9199) instead of the project in
# the values above. Default is FALSE, so a build that inherits this file always
# talks to the real project. Start them with:
#   npx firebase-tools emulators:start --only firestore,auth,storage --project demo-himalye-gym
VITE_FIREBASE_EMULATORS=false
