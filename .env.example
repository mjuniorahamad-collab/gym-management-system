# ------------------------------------------------------------------
# Gym Management System — Firebase configuration
# Copy this file to `.env` and fill in your Firebase project values.
# NEVER commit the real `.env` file.
# ------------------------------------------------------------------



VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# Set to "true" ONLY in development to allow seeding sample data.
# The app NEVER auto-seeds in production builds.
VITE_ENABLE_SEEDING=true
