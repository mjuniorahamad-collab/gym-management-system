rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ---------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    // Reads the caller's profile doc. Admin/write access is derived from role.
    //
    // NULL-SAFE: a caller with no profile document yet (brand-new signup, or
    // an unauthenticated/anon request) yields null instead of raising a rules
    // evaluation error. Every role-derived guard therefore denies explicitly
    // rather than by exception, so access control never depends on a crash.
    function role() {
      let ref = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(ref) && 'role' in get(ref).data ? get(ref).data.role : null;
    }

    function isRole(r) {
      return isSignedIn() && role() == r;
    }

    // Any staff member can read operational data.
    function isStaff() {
      return isSignedIn() && role() in ['owner', 'admin', 'front-desk', 'trainer'];
    }

    // Only owner/admin touch financial records.
    function isFinance() {
      return isRole('owner') || isRole('admin');
    }

    function isOwner() {
      return isRole('owner');
    }

    // ---------- Tenancy helpers ---------------------------------------------
    // The caller's gym is derived from users/{uid}.gymId. It is the source of
    // truth for data isolation and can only be set once (see the users block).
    // gymId is deliberately NOT client-assignable after bootstrap.
    //
    // This accessor is NULL-SAFE: it never dereferences a missing profile (a
    // brand-new user who has not yet bootstrapped has no users/{uid} doc).
    // Accessing .data.gymId on a non-existent document raises a rules
    // evaluation error (which surfaces as PERMISSION_DENIED), so we guard with
    // exists(...) and a field check. A null result simply means "no bound gym
    // yet", letting a fresh owner reach the self-provisioning onboarding path.
    function gymOf(uid) {
      let ref = /databases/$(database)/documents/users/$(uid);
      return exists(ref) && 'gymId' in get(ref).data ? get(ref).data.gymId : null;
    }

    // True when the caller's profile exists and carries a bound gymId.
    function hasGym() {
      return isSignedIn() && gymOf(request.auth.uid) != null;
    }

    // True when a document is untagged (pre-tenancy legacy record). Legacy
    // records stay readable and migratable so existing data is never lost
    // during backfill; they cannot be newly created and cannot be moved to a
    // different gym — only tagged to the caller's gym (see canWriteTenant).
    function legacy(resource) {
      return resource != null && !('gymId' in resource.data);
    }

    // True when a document belongs to the caller's own gym.
    // NULL-SAFE: an absent document, or a legacy document that carries no
    // gymId at all, evaluates to false rather than raising an error on the
    // missing field.
    function sameGym(resource) {
      return isSignedIn() && hasGym()
        && resource != null
        && 'gymId' in resource.data
        && resource.data.gymId == gymOf(request.auth.uid);
    }

    // Read guard: the record is in the caller's gym, or is a legacy record
    // that has not yet been claimed by any gym (preserves existing data).
    function canReadTenant(resource) {
      return sameGym(resource) || legacy(resource);
    }

    // Write guard (create + update). For creates (resource == null) the new
    // document MUST carry the caller's bound gymId — opaque legacy creates
    // are not allowed. For updates the document must ALREADY be in the
    // caller's gym, and the resulting document must carry the same gymId, so
    // an existing gymId can never be changed.
    //
    // Note the absence of any `legacy(resource)` escape hatch: a pre-tenancy
    // untagged document can no longer be adopted by whichever tenant acts
    // first. Client-driven adoption is the "first-come-first-served" claim
    // hazard, so untagged records are left untouched here and handled only by
    // the audited Admin migration. They stay READABLE (see canReadTenant) so
    // no existing data disappears before that migration runs.
    function canWriteTenant(resource) {
      return hasGym()
        && 'gymId' in request.resource.data
        && request.resource.data.gymId == gymOf(request.auth.uid)
        && (resource == null || sameGym(resource));
    }

    // Delete guard: only scoped, own-gym records can be removed.
    function canDeleteTenant(resource) {
      return sameGym(resource);
    }

    // ---------- Payment receipt integrity -----------------------------------
    // A receipt number is a brand, not a label: it is printed on receipts and
    // persisted onto payment records, so a finance client must not be able to
    // mint one under a foreign or invented prefix by writing `payments`
    // directly through the SDK.
    //
    // The ONLY authoritative prefix is gyms/{gymId}.receiptPrefix — merged in
    // at onboarding / by the audited bootstrap and then frozen to clients by
    // the gyms block (`allow update, delete: if false`). This mirrors, at the
    // rules layer, the runtime guard in src/services/receiptPrefixGuard.js, so
    // the invariant no longer depends on the app being the writer.
    //
    // NULL-SAFE / FAIL-CLOSED: a missing gym document, a gym with no
    // receiptPrefix field, or a non-string value yields null, which makes the
    // create check below false (deny) instead of raising an evaluation error.
    function gymReceiptPrefix(gymId) {
      let ref = /databases/$(database)/documents/gyms/$(gymId);
      return exists(ref) && 'receiptPrefix' in get(ref).data
        ? get(ref).data.receiptPrefix
        : null;
    }

    // True when `no` is exactly "<prefix>-<digits>" for the given prefix. The
    // prefix is compared by EQUALITY, so an arbitrary brand that merely
    // satisfies the generic shape is still rejected. The digit run accepts the
    // canonical 6-digit counter receipt, the wider 13-digit epoch-ms fallback,
    // and seeded sample receipts; the length cap bounds pathological input.
    //
    // Not sequence validation: rules cannot enforce counter uniqueness or
    // monotonicity (no queries, and the counter read sees its pre-transaction
    // value). That remains outside this phase.
    function receiptNoUnderPrefix(no, prefix) {
      return prefix is string
        && no is string
        && no.size() <= 24
        && no.matches('^[A-Za-z0-9]{1,8}-[0-9]+$')
        && no.split('-')[0] == prefix;
    }

    // Create: the new receipt number must be issued under the caller's OWN
    // authoritative prefix (fail closed when that authority is absent).
    // Update: the existing receipt number is IMMUTABLE — a client may edit any
    // other payment field, but may never change, remove, or replace receiptNo.
    // This also covers historical receipts ("001", "HWG-...", or any legacy
    // value), which stay updatable for unrelated fields because the update arm
    // compares receiptNo for equality with its stored value rather than
    // re-validating its shape.
    function paymentReceiptIntegrity() {
      return resource == null
        ? receiptNoUnderPrefix(request.resource.data.get('receiptNo', null),
            gymReceiptPrefix(request.resource.data.gymId))
        : request.resource.data.get('receiptNo', null) == resource.data.get('receiptNo', null);
    }

    // A user may only bind gymId once, only on their own profile, and only to
    // a gym whose owner-of-record is themselves (pre-provisioned in the gyms
    // collection — never client-created). After it is set it is frozen.
    //
    // The bind is additionally pinned so it can never INTRODUCE a new role.
    // Owner-of-record status authorises binding, not self-granting: the bind
    // may establish role 'owner', may omit the role entirely (a pre-seeded
    // profile that already carries one), or may only re-state the role the
    // profile already has. Any other value — 'superadmin', 'trainer', or a
    // misspelling like 'OWNER' — is denied, so being the owner-of-record of a
    // gym is not a launchpad for self-assigning an arbitrary role.
    function canBindGymId(uid) {
      return isSignedIn()
        && request.auth.uid == uid
        && (resource == null || !('gymId' in resource.data))
        && 'gymId' in request.resource.data
        && (!('role' in request.resource.data)
          || request.resource.data.role == 'owner'
          || (resource != null && 'role' in resource.data
            && request.resource.data.role == resource.data.role))
        && exists(/databases/$(database)/documents/gyms/$(request.resource.data.gymId))
        && get(/databases/$(database)/documents/gyms/$(request.resource.data.gymId)).data.ownerUid == request.auth.uid;
    }

    // Role is WRITE-ONCE: once a profile carries a role it can never be
    // changed, by anyone — not by an admin, not even by the owner of the gym.
    // This closes the privilege-escalation path where an existing staff
    // account rewrites its own `role` field to `owner`. Combined with
    // `allow delete: if false` and gymId being frozen by canBindGymId, an
    // account's authority is fully determined at creation time.
    //
    // A profile that has no role yet (legacy or partially-written) may still
    // receive one, so onboarding is unaffected.
    function roleWriteOnce() {
      return !(resource != null && 'role' in resource.data)
        || ('role' in request.resource.data
            && request.resource.data.role == resource.data.role);
    }

    // True when a pending (to-be-written) document carries the caller's gymId.
    // Used to ensure admin/owner-managed user writes never move a user to
    // another gym, so a bound gymId stays frozen.
    function sameGymForRequest() {
      return hasGym() && 'gymId' in request.resource.data
        && request.resource.data.gymId == gymOf(request.auth.uid);
    }

    // Returns true when the caller belongs to the gym that owns a users/{uid}
    // doc, so staff can only manage members of their own gym.
    function inCallerGym(uid) {
      return hasGym() && gymOf(uid) == gymOf(request.auth.uid);
    }

    // ---------- Gyms (owner-of-record) --------------------------------------
    // gyms/{gymId} holds the owner-of-record for a gym. It is normally
    // provisioned out-of-band (console/CLI/script), but an owner can ALSO
    // self-provision their own brand-new gym once from the app.
    //
    // A user may read a gyms doc only if it is their own gym (either they
    // already belong to it, or they ARE the owner-of-record, used to discover
    // their gymId during a secure one-time bootstrap).
    //
    // Self-provisioning is create-only and gated so a gym cannot be claimed,
    // squatted or stolen: the doc must be owned by the caller (ownerUid ==
    // request.auth.uid) AND be created at a genuine random Firestore auto-id
    // (isAutoId). Because auto-ids are random and unknowable in advance, and a
    // user can only ever bind a gym they own, no one can pre-register a slug,
    // claim another owner's record, or overwrite an existing provisioned gym.
    function isAutoId(id) {
      return id.size() == 20 && id.matches('[A-Za-z0-9_-]{20}');
    }

    match /gyms/{gymId} {
      allow read: if isSignedIn()
        && resource != null
        && 'ownerUid' in resource.data
        && (resource.data.ownerUid == request.auth.uid || (hasGym() && gymOf(request.auth.uid) == gymId));
      allow create: if isSignedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && isAutoId(gymId);
      allow update, delete: if false;
    }

    // ---------- Gym settings (per-gym, tenant-isolated) --------------------
    // PT pricing (and any future per-gym config) lives as a sub-collection of
    // the owner-of-record gym document. Unlike the global `settings/app`
    // singleton (shared across tenants), these documents carry gymId and are
    // scoped to their own gym, so Owner A can never read or modify Owner B's
    // PT pricing.
    //
    // Read: any staff member of the owning gym (like other operational data).
    // Write (create/update): the owner of THAT gym only, and the pending doc
    // must carry the caller's gymId — cross-gym writes are impossible. Deletes
    // are never allowed from the client.
    match /gyms/{gymId}/settings/{doc} {
      allow read: if isSignedIn()
        && hasGym()
        && resource != null
        && 'gymId' in resource.data
        && resource.data.gymId == gymOf(request.auth.uid);
      allow create, update: if isOwner()
        && 'gymId' in request.resource.data
        && request.resource.data.gymId == gymOf(request.auth.uid)
        && gymOf(request.auth.uid) == gymId;
      allow delete: if false;
    }

    // ---------- Users (auth profiles + roles) -----------------------------
    match /users/{uid} {
      // A user can always read their own profile, plus profiles within their
      // own gym. Cross-gym profiles are never readable (tenant isolation).
      allow read: if isSignedIn()
        && (request.auth.uid == uid || inCallerGym(uid));
      // Self-registration on first login (one-time owner bind allowed), or
      // admin/owner managing staff within their own gym. Two invariants hold
      // on every write:
      //   * `roleWriteOnce()` — role is fixed at creation and never changes.
      //   * `sameGymForRequest()` — a bound gymId stays frozen, so a user can
      //     never be moved to another gym.
      // The application never mutates an existing users/{uid} document after
      // creation, so these invariants cost no legitimate functionality.
      allow create, update: if isSignedIn()
        && roleWriteOnce()
        && (
          canBindGymId(uid)
          || (isRole('admin') && inCallerGym(uid) && sameGymForRequest())
          || (isOwner() && inCallerGym(uid) && sameGymForRequest())
        );
      // Profiles are never client-deletable. Deleting the binding owner
      // profile would orphan the tenant, and deleting a staff profile is a
      // privilege-revocation path with no compensating audit trail here.
      // Account removal is an Admin/console operation, not a client one.
      allow delete: if false;
    }

    // ---------- Members ---------------------------------------------------
    // Privilege separation on member fields. Roles that hold
    // PERMISSIONS['members.write'] (owner, admin, front-desk) may write a
    // member document freely. A trainer — a staff role the application does
    // NOT grant 'members.write' to — may still write a member document, but
    // only where it neither INTRODUCES nor ALTERS a financially significant
    // field.
    //
    // This is deliberately field-level rather than a blanket trainer denial:
    //   * setting a fitness goal / target weight is a real trainer capability
    //     (src/services/weightRecords.js -> updateDocById('members', …,
    //     { fitnessGoal, targetWeight })) and touches none of these fields;
    //   * the renewal write path does write membershipPlanId/joinDate, but a
    //     trainer can never reach it: createDoc('payments', …) runs
    //     first and is finance-gated (owner/admin), so the request fails
    //     before the member document is touched.
    //
    // A trainer may therefore add a previously-absent significant field
    // (backfilling an empty slot) but may never change one that already
    // carries a value, which is where the financial exposure lives.
    function trainerMayWriteField(f) {
      return resource == null
        // create: a financially significant field may not be introduced
        ? !(f in request.resource.data)
        // update: a field that already exists may not be altered
        : (!(f in request.resource.data) || !(f in resource.data));
    }

    function memberWriteWithinRole() {
      return isOwner() || isRole('admin') || isRole('front-desk')
        || (isRole('trainer')
          && trainerMayWriteField('membershipPlanId')
          && trainerMayWriteField('isPT')
          && trainerMayWriteField('ptSurchargeOverride')
          && trainerMayWriteField('joinDate'));
    }

    // ---------- Server-owned projection fields -----------------------------
    //
    // These five are the member projection. They are an OUTPUT of
    // `memberships` + `membershipFreezes` as computed by the canonical engine,
    // and they are written by exactly one writer: the trusted server writer,
    // using the Admin SDK, which bypasses these rules entirely because it is
    // trusted rather than because it is exempt.
    //
    // No role may set them. Not owners, not admins, not front-desk, not trainers.
    // A role check would be the wrong tool: this is not a question of who is
    // trusted, it is a question of who can compute the right answer. Only the
    // server reads the authoritative documents and derives these values.
    //
    // Note what is deliberately NOT in this list: `isPT`, `membershipPlanId`,
    // `joinDate`, `ptSurchargeOverride`. Those are member FACTS a staff member
    // may legitimately record. `isPT` in particular shares a name with a
    // projection field derived from the period, but it is a different value on a
    // different document — the engine derives `isPT` from the current period and
    // never reads the member document. Locking it here would break the PT toggle
    // and the repricing it drives.
    //
    // `isFrozen` is server-owned for the same reason as the others: only the
    // engine sees the freeze records, so only it can say whether a freeze covers
    // gym-local today. It is orthogonal to currency - `status` decides whether the
    // membership is paid up, `isFrozen` is a flag beside it - so `active` plus
    // `isFrozen` is a legitimate and expected combination, and `frozen` remains
    // absent from `status` on purpose.
    function projectionFieldsAbsent() {
      return !request.resource.data.keys().hasAny([
        'membershipStart', 'effectiveExpiry', 'freezeUntil', 'status', 'isFrozen'
      ]);
    }

    // Every field is read through get(field, null) rather than dot access.
    // Dot access on an ABSENT field is not "null" in the rules language — it
    // raises an evaluation error, and an evaluation error DENIES the request.
    // Members predating the projection legitimately have none of these fields,
    // so dot access here would lock staff out of editing exactly the documents
    // that have had no projection written to them yet.
    function projectionFieldsUnchanged() {
      return request.resource.data.get('membershipStart', null) == resource.data.get('membershipStart', null)
        && request.resource.data.get('effectiveExpiry',  null) == resource.data.get('effectiveExpiry',  null)
        && request.resource.data.get('freezeUntil',      null) == resource.data.get('freezeUntil',      null)
        && request.resource.data.get('status',           null) == resource.data.get('status',           null)
        && request.resource.data.get('isFrozen',         null) == resource.data.get('isFrozen',         null);
    }

    // Compared field by field against a named list, NOT by whole-document
    // equality and NOT by an affectedKeys() allowlist.
    //
    // Whole-document equality would deny every legitimate edit (name, phone,
    // notes), which is the opposite of the intent. An allowlist of writable keys
    // would have to be maintained by hand and would silently break the moment a
    // new legitimate field appeared — and would grant nothing to the fields it
    // forgot. Naming the five server-owned fields states the invariant directly:
    // these are not yours, and everything else is.
    //
    // Each field is compared on update rather than merely "not present in
    // affectedKeys", so a client cannot bypass the rule by writing a projection
    // field with the value it already has and only later changing it — the value
    // it must match is the server's, not a client's.
    function clientCannotWriteProjection() {
      return resource == null
        ? projectionFieldsAbsent()
        : projectionFieldsUnchanged();
    }

    match /members/{id} {
      allow read: if isStaff() && canReadTenant(resource);
      allow create: if isStaff() && memberWriteWithinRole()
                    && canWriteTenant(resource)
                    && clientCannotWriteProjection();
      allow update: if isStaff() && memberWriteWithinRole()
                    && canWriteTenant(resource)
                    && clientCannotWriteProjection();
      allow delete: if (isRole('admin') || isOwner()) && canDeleteTenant(resource);
    }

    // ---------- Weight records (member fitness progress) -------------------
    // Historical weight measurements keyed by memberId and scoped to the
    // caller's gym. Same tenancy + role guards as members.
    match /weightRecords/{id} {
      allow read: if isStaff() && canReadTenant(resource);
      allow create, update: if isStaff() && canWriteTenant(resource);
      allow delete: if (isRole('admin') || isOwner()) && canDeleteTenant(resource);
    }

    // ---------- Counters (sequence sources, e.g. member numbers) -----------
    match /counters/{id} {
      // A point-read of a document that DOES NOT EXIST is permitted for bound
      // staff. This is required by the member-number sequence, which runs a
      // single transaction that reads `counters/memberNo_<gymId>` and then
      // creates it (see src/services/memberNumbers.js). Firestore evaluates
      // the read half of a transaction against `resource == null`, and every
      // tenant guard below is false for a null document, so without this the
      // very first member created in a new gym would fail PERMISSION_DENIED.
      //
      // This discloses nothing: a missing document has no contents, so the
      // response is simply "not found". It grants no access to any existing
      // document — `canReadTenant` still governs every real counter, so
      // cross-gym reads stay denied and an untagged legacy counter stays
      // readable only by the documented legacy path. Writes are untouched:
      // `canWriteTenant` requires the caller's own gymId and has no
      // untagged-claim escape hatch, so no counter can be adopted from a
      // client.
      allow read: if isStaff() && ((resource == null && hasGym()) || canReadTenant(resource));
      allow create, update: if isStaff() && canWriteTenant(resource);
    }

    // ---------- Trainers --------------------------------------------------
    match /trainers/{id} {
      allow read: if isStaff() && canReadTenant(resource);
      allow create, update: if (isRole('admin') || isOwner()) && canWriteTenant(resource);
      allow delete: if isOwner() && canDeleteTenant(resource);
    }

    // ---------- Membership plans ------------------------------------------
    match /membershipPlans/{id} {
      allow read: if isStaff() && canReadTenant(resource);
      allow create, update: if isFinance() && canWriteTenant(resource);
      allow delete: if isFinance() && canDeleteTenant(resource);
    }

    // ---------- Memberships (per-period records — financial) ----------------
    match /memberships/{id} {
      allow read: if isStaff() && canReadTenant(resource);
      allow create, update: if isFinance() && canWriteTenant(resource);
      allow delete: if isOwner() && canDeleteTenant(resource);
    }

    // ---------- Membership freezes (immutable, derived expiry) ---------------
    // A freeze suspends a period's countdown. It must never edit the period:
    // effective expiry is DERIVED from the period's original expiry plus these
    // intervals, so the amount the member actually paid for stays on record.
    //
    // Append-only, like the audit log. Cancelling a freeze appends a
    // `kind: 'cancellation'` document referencing the freeze it voids; there is
    // deliberately no update and no delete path, so a freeze's history cannot be
    // rewritten after the fact. `isFinance()` on create because a freeze grants
    // a member paid-for time and so changes what is owed.
    match /membershipFreezes/{id} {
      allow read: if isStaff() && canReadTenant(resource);
      allow create: if isFinance() && canWriteTenant(resource);
      allow update, delete: if false;
    }

    // ---------- Payments (financial — owner/admin only) --------------------
    match /payments/{id} {
      allow read: if isFinance() && canReadTenant(resource);
      allow create, update: if isFinance() && canWriteTenant(resource) && paymentReceiptIntegrity();
      allow delete: if isOwner() && canDeleteTenant(resource);
    }

    // ---------- Expenses (financial — owner/admin only) --------------------
    match /expenses/{id} {
      allow read: if isFinance() && canReadTenant(resource);
      allow create, update: if isFinance() && canWriteTenant(resource);
      allow delete: if isOwner() && canDeleteTenant(resource);
    }

    // ---------- Attendance -------------------------------------------------
    match /attendance/{id} {
      allow read: if isStaff() && canReadTenant(resource);
      allow create, update: if isStaff() && canWriteTenant(resource);
      allow delete: if (isRole('admin') || isOwner()) && canDeleteTenant(resource);
    }

    // ---------- Attendance sessions (open check-in pointers) -----------------
    // One document per (gym, member) at a deterministic id. Check-in reads this
    // path inside a transaction and writes the attendance record and this
    // pointer together, so two devices checking the same member in at the same
    // moment contend on one document and exactly one wins — see
    // src/services/attendanceSessions.js.
    //
    // The `resource == null` arm is required, not a convenience. The very first
    // check-in of a member in a gym reads a pointer that does not exist yet, and
    // Firestore evaluates that read against `resource == null`, for which every
    // tenant guard below is false. Without this arm the first check-in of the
    // first member in a new gym fails PERMISSION_DENIED. It discloses nothing:
    // a missing document has no contents, so the answer is simply "not found",
    // and it grants no access to any existing pointer.
    match /attendanceSessions/{id} {
      allow read: if isStaff() && ((resource == null && hasGym()) || canReadTenant(resource));
      allow create, update: if isStaff() && canWriteTenant(resource);
      // Delete is a separate clause, not `canWriteTenant`. That helper inspects
      // `request.resource.data.gymId`, and on a delete there is no incoming
      // document, so the access raises a null-value error and the delete is
      // denied - which would strand every member who could never check out.
      // `canDeleteTenant` reads only `resource`, so it is the correct guard.
      //
      // Staff may release a pointer on checkout, which is why this is not
      // owner-only as it is for financial records. This is an operational
      // pointer, not money: it carries no amount and no ledger entry, and staff
      // already create and update attendance rows directly. The transaction
      // still requires the pointer's gymId to match the caller's own gym.
      allow delete: if isStaff() && canDeleteTenant(resource);
    }

    // ---------- Classes ----------------------------------------------------
    match /classes/{id} {
      allow read: if isStaff() && canReadTenant(resource);
      allow create, update: if (isFinance() || isRole('front-desk')) && canWriteTenant(resource);
      allow delete: if (isFinance() || isRole('front-desk')) && canDeleteTenant(resource);
    }

    // ---------- Bookings ---------------------------------------------------
    // Booking ownership is resolved SERVER-SIDE from the referenced member
    // document. The denormalised `gymId` inside a booking payload is entirely
    // attacker-controlled, so trusting it would let any staff account mint a
    // booking inside another gym just by writing that gym's id. Every
    // referenced member must exist and belong to the caller's own gym.
    function memberInCallerGym(id) {
      return id is string
        && id.size() > 0
        && exists(/databases/$(database)/documents/members/$(id))
        && get(/databases/$(database)/documents/members/$(id)).data.gymId == gymOf(request.auth.uid);
    }

    // The referenced class must exist AND belong to the caller's gym. The
    // application always persists a `classes/{id}` document before booking
    // against it — the booking form derives classId from a class already
    // materialised in the page state (src/pages/Classes.jsx) — so requiring
    // existence is satisfiable by the real client. A present-but-untagged
    // class denies, so a foreign or pre-tenancy class can never be referenced.
    //
    // Note this is an integrity constraint, not a confidentiality one: the
    // `classes` read rule already exposes every class in the caller's own gym
    // to any staff account, so a booking can never disclose a class document
    // the caller could not already read.
    function classInCallerGym(id) {
      return id is string
        && id.size() > 0
        && exists(/databases/$(database)/documents/classes/$(id))
        && get(/databases/$(database)/documents/classes/$(id)).data.gymId == gymOf(request.auth.uid);
    }

    // Staff roles (owner/admin/trainer/front-desk) retain booking CRUD, which
    // matches the application's 'Manage bookings' affordance for every staff
    // role that can open the Classes page. Only the reference constraints above
    // are tightened; no role was added or removed.
    //
    // `allow update` re-validates both references on every write, so an existing
    // booking cannot be repointed at another tenant's member or class. It is not
    // reachable from current application code (src/pages/Classes.jsx only ever
    // deletes a booking) and is specified defensively. Note that once a class is
    // deleted its bookings become orphans that can still be read and deleted but
    // not updated; that is the accepted data-integrity state, not a regression.
    match /bookings/{id} {
      allow read: if isStaff() && canReadTenant(resource);
      allow create, update: if isStaff() && canWriteTenant(resource)
        && memberInCallerGym(request.resource.data.memberId)
        && classInCallerGym(request.resource.data.classId);
      allow delete: if isStaff() && canDeleteTenant(resource);
    }

    // ---------- Audit log (append-only by staff, read by finance) ----------
    match /auditLog/{id} {
      allow read: if isFinance() && canReadTenant(resource);
      allow create: if isStaff() && canWriteTenant(resource);
      allow update, delete: if false;
    }

    // ---------- Legacy global app settings (settings/app) -------------------
    // `settings/app` is a PRE-MIGRATION singleton that carries a `gymId`
    // field identifying the single tenant that owns it. It is being retired
    // in favour of the per-gym document at gyms/{gymId}/settings/app.
    //
    // Interim posture — deliberately stricter than the previous global
    // `allow read: if isSignedIn()`: the singleton is isolated by its OWN
    // gymId, so only the owning gym can read or update it. Another gym's
    // owner can neither read it nor overwrite it. A collection-wide read is
    // denied because `resource` is null for a query.
    //
    // create and delete are denied outright: every new settings document must
    // be created under gyms/{gymId}/settings/app, and a client must never be
    // able to remove the shared document other tenants still read from.
    //
    // This block is replaced by `if false` once every active gym has a
    // validated per-gym settings document (deployment gate S4 of the Phase 1
    // plan). That retirement is intentionally NOT performed here because the
    // production data migration has not run; flipping it now would break the
    // live app, since no gyms/{gymId}/settings/app documents exist yet.
    match /settings/{doc} {
      allow read: if isSignedIn()
        && hasGym()
        && resource != null
        && 'gymId' in resource.data
        && resource.data.gymId == gymOf(request.auth.uid);
      allow update: if isOwner()
        && hasGym()
        && resource != null
        && 'gymId' in resource.data
        && resource.data.gymId == gymOf(request.auth.uid)
        && 'gymId' in request.resource.data
        && request.resource.data.gymId == gymOf(request.auth.uid);
      allow create, delete: if false;
    }

    // ---------- Migration state (reserved, no client access) ----------------
    // tenancy/{document=**} holds the migration / restore ledger (for example
    // tenancy/migrationState). It is written only by trusted infrastructure
    // (Admin SDK with owner-level credentials, or a named backup/restore
    // service identity) using rules-bypassed access; clients have no path to
    // it. The explicit deny also closes off any future client code that might
    // try to claim tenancy ownership of unscoped documents.
    match /tenancy/{document=**} {
      allow read, write: if false;
    }
  }
}
